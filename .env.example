# Copiá a .env y completá lo que esté entre < >.
# Los defaults de infra local salen de docker-compose.yml (+ .override.yml).

# --- Infra ---
DATABASE_URL=postgresql://<user>:<password>@localhost:<port>/codebase_doctor
REDIS_HOST=localhost
REDIS_PORT=6379

# --- API ---
PORT=3000
# UPGRADE_URL=            # opcional; default https://codebasedoctor.dev/pricing

# --- LLM judge (categorías Architecture + Documentation) ---
# stub      = gratis, offline, scores falsos deterministas (modelId "stub-judge")
# anthropic = judging real, PAGO, requiere ANTHROPIC_API_KEY
# Sin LLM_JUDGE y sin ANTHROPIC_API_KEY: fuera de prod cae al stub con warning;
# con NODE_ENV=production no arranca (fail-fast).
LLM_JUDGE=stub
ANTHROPIC_API_KEY=<anthropic-api-key>

# Knob de dev del StubJudgeAdapter — CategoryIds separados por coma a forzar-fallar:
#   architecture,security,testing,maintainability,performance,documentation
# STUB_JUDGE_FAIL_CATEGORIES=

# NODE_ENV=development