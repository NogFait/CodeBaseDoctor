# Copiá a .env y completá lo que esté entre < >.
# Los defaults de infra local salen de docker-compose.yml (+ .override.yml).

# --- Infra ---
DATABASE_URL=postgresql://<user>:<password>@localhost:<port>/codebase_doctor
REDIS_HOST=localhost
REDIS_PORT=6379

# --- API ---
PORT=3000
# UPGRADE_URL=            # opcional; default https://codebasedoctor.dev/pricing
# Obligatorio con NODE_ENV=production (la API no arranca sin esto): openssl rand -hex 32
# ACTOR_SALT_SECRET=
# Detrás de un proxy/PaaS: cantidad de saltos (1). Sin esto todos comparten una cuota.
# TRUST_PROXY=
# Orígenes permitidos, separados por coma. Vacío = CORS apagado.
# CORS_ORIGINS=

# --- LLM judge (categorías Architecture + Documentation) ---
# stub      = gratis, offline, scores falsos deterministas (modelId "stub-judge")
# openai    = juez real y GRATIS con cualquier endpoint OpenAI-compatible (Groq, etc.)
# anthropic = juez real, PAGO, requiere ANTHROPIC_API_KEY
# Sin LLM_JUDGE: si hay LLM_BASE_URL usa openai; si hay ANTHROPIC_API_KEY usa anthropic;
# si no, fuera de prod cae al stub con warning y con NODE_ENV=production no arranca.
LLM_JUDGE=stub

# Para openai: LLM_JUDGE=openai + estas tres (Groq de ejemplo, key gratis en console.groq.com)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# LLM_API_KEY=<groq-api-key>

# Para anthropic: LLM_JUDGE=anthropic + key
# ANTHROPIC_API_KEY=<anthropic-api-key>

# Knob de dev del StubJudgeAdapter — CategoryIds separados por coma a forzar-fallar:
#   architecture,security,testing,maintainability,performance,documentation
# STUB_JUDGE_FAIL_CATEGORIES=

# NODE_ENV=development